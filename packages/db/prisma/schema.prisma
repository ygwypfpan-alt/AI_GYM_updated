generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum ConversationStatus {
  OPEN
  HANDED_OFF
  CLOSED
}

enum ConversationChannel {
  WEB_CHAT
}

enum MessageSender {
  USER
  BOT
  STAFF
  SYSTEM
}

enum HandoffStatus {
  PENDING
  RESOLVED
}

model Business {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  slug              String             @unique
  timezone          String             @default("Asia/Taipei")
  phone             String?
  email             String?
  address           String?
  customers         Customer[]
  services          Service[]
  staff             Staff[]
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  conversations     Conversation[]
  faqItems          FaqItem[]
  handoffRequests   HandoffRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("businesses")
}

model Customer {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @db.Uuid
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  email           String?
  note            String?
  bookings        Booking[]
  conversations   Conversation[]
  handoffRequests HandoffRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("customers")
}

model Service {
  id                String             @id @default(uuid()) @db.Uuid
  businessId        String             @db.Uuid
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  durationMinutes   Int
  price             Int?
  isActive          Boolean            @default(true)
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("services")
}

model Staff {
  id                String             @id @default(uuid()) @db.Uuid
  businessId        String             @db.Uuid
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  bio               String?
  isActive          Boolean            @default(true)
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("staff")
}

model AvailabilityRule {
  id                  String    @id @default(uuid()) @db.Uuid
  businessId          String    @db.Uuid
  serviceId           String?   @db.Uuid
  staffId             String?   @db.Uuid
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service             Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff               Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotIntervalMinutes Int       @default(60)
  capacity            Int       @default(1)
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([businessId, dayOfWeek])
  @@map("availability_rules")
}

model Booking {
  id                 String         @id @default(uuid()) @db.Uuid
  businessId         String         @db.Uuid
  customerId         String         @db.Uuid
  serviceId          String         @db.Uuid
  staffId            String?        @db.Uuid
  conversationId     String?        @db.Uuid
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service            Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff              Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  conversation       Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status             BookingStatus  @default(BOOKED)
  startAt            DateTime
  endAt              DateTime
  notes              String?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([businessId, startAt])
  @@index([customerId, status])
  @@map("bookings")
}

model Conversation {
  id              String             @id @default(uuid()) @db.Uuid
  businessId      String             @db.Uuid
  customerId      String?            @db.Uuid
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel         ConversationChannel @default(WEB_CHAT)
  status          ConversationStatus @default(OPEN)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  messages        Message[]
  bookings        Booking[]
  handoffRequests HandoffRequest[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([businessId, status])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  text           String
  intent         String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model FaqItem {
  id        String    @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category  String?
  question  String
  answer    String
  keywords  String[]  @default([])
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([businessId, isActive])
  @@map("faq_items")
}

model HandoffRequest {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @db.Uuid
  customerId     String?       @db.Uuid
  conversationId String?       @db.Uuid
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         HandoffStatus @default(PENDING)
  name           String?
  phone          String?
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId, status])
  @@map("handoff_requests")
}
